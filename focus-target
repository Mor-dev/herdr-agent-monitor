#!/usr/bin/env bash
# Focuses an agent pane, workspace, or notification target in herdr (local or remote machine)
# or Herdr App (hc), and focuses the corresponding terminal or Herdr App window in Niri.
#
# Usage:
#   focus-target agent <backend> <machine_id> <pane_id> [workspace_id] [tab_id]
#   focus-target workspace <backend> <machine_id> <workspace_id> [tab_id]
#   focus-target window [backend] [machine_id]
#   focus-target notification <summary> <body>
#   focus-target reemit-notification <summary> <body>

set -u

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
kind="${1:-window}"
backend="${2:-herdr}"
machine="${3:-local}"
target_id="${4:-}"
workspace_id="${5:-}"
tab_id="${6:-}"

ensure_runtime_env() {
    export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
    if [[ -z "${WAYLAND_DISPLAY:-}" ]]; then
        local wsock
        for wsock in "$XDG_RUNTIME_DIR"/wayland-*; do
            if [[ -S "$wsock" ]]; then
                export WAYLAND_DISPLAY
                WAYLAND_DISPLAY="$(basename "$wsock")"
                break
            fi
        done
    fi
    if [[ -z "${NIRI_SOCKET:-}" || ! -S "${NIRI_SOCKET:-}" ]]; then
        local nsock
        for nsock in $(ls -t "$XDG_RUNTIME_DIR"/niri*.sock 2>/dev/null || true); do
            if [[ -S "$nsock" ]] && NIRI_SOCKET="$nsock" niri msg -j version >/dev/null 2>&1; then
                export NIRI_SOCKET="$nsock"
                break
            fi
        done
    fi
}

focus_niri_herdr_window() {
    local target_machine="${1:-local}"
    command -v niri >/dev/null 2>&1 || return 0
    command -v jq >/dev/null 2>&1 || return 0

    local windows_json
    windows_json="$(niri msg -j windows 2>/dev/null)" || return 0
    [[ -n "$windows_json" ]] || return 0

    local target_host="$target_machine"
    if [[ "$target_machine" == "local" || -z "$target_machine" ]]; then
        target_host="$(hostname 2>/dev/null || echo "local")"
    fi

    # Collect ancestor PIDs of active herdr client processes (excluding background `herdr server`)
    local herdr_pids client_pids="" p cmd cur ancestor_pids=","
    herdr_pids="$(pgrep -x herdr 2>/dev/null || true)"
    for p in $herdr_pids; do
        cmd="$(ps -o args= -p "$p" 2>/dev/null || true)"
        if [[ "$cmd" != *"herdr server"* ]]; then
            client_pids="$client_pids $p"
        fi
    done
    [[ -z "${client_pids// /}" ]] && client_pids="$herdr_pids"

    for p in $client_pids; do
        cur="$p"
        while [[ -n "$cur" && "$cur" != "1" && "$cur" != "0" ]]; do
            if [[ "$ancestor_pids" != *",$cur,"* ]]; then
                ancestor_pids="${ancestor_pids}${cur},"
            fi
            cur="$(ps -o ppid= -p "$cur" 2>/dev/null | tr -d ' ')"
        done
    done

    local win_id
    win_id="$(
        jq -r --arg anc "$ancestor_pids" --arg thost "$target_host" '
            def is_anc: (.pid != null) and ($anc | contains("," + (.pid | tostring) + ","));
            def title_lc: (.title // "" | ascii_downcase);
            def app_lc: (.app_id // "" | ascii_downcase);
            def matches_host: title_lc | startswith(($thost | ascii_downcase) + ": ");
            def looks_like_herdr: (title_lc | contains("herdr")) or (app_lc | contains("herdr")) or (title_lc | test("^[a-z0-9._-]+: "));

            (
                [ .[] | select(is_anc and matches_host) ]
                + [ .[] | select(is_anc and looks_like_herdr) ]
                + [ .[] | select(is_anc) ]
                + [ .[] | select(matches_host) ]
                + [ .[] | select((title_lc | contains("herdr")) or (app_lc | contains("herdr"))) ]
            )
            | map(.id)
            | first // empty
        ' <<<"$windows_json" 2>/dev/null
    )"

    if [[ -n "$win_id" ]]; then
        niri msg action focus-window --id "$win_id" >/dev/null 2>&1 || true
    fi
}

focus_niri_hc_window() {
    command -v niri >/dev/null 2>&1 || return 0
    command -v jq >/dev/null 2>&1 || return 0

    local windows_json win_id
    windows_json="$(niri msg -j windows 2>/dev/null)" || return 0
    [[ -n "$windows_json" ]] || return 0

    win_id="$(
        jq -r '
            .[]
            | select(
                ((.app_id // "" | ascii_downcase) == "herdr-app")
                or ((.title // "" | ascii_downcase) == "herdr")
                or ((.app_id // "" | ascii_downcase) | contains("herdr-app"))
            )
            | .id
        ' <<<"$windows_json" 2>/dev/null | head -n1
    )"
    if [[ -n "$win_id" ]]; then
        niri msg action focus-window --id "$win_id" >/dev/null 2>&1 || true
    fi
}

ensure_hc_window_open() {
    command -v herdr-app >/dev/null 2>&1 || return 0
    if ! herdr-app status >/dev/null 2>&1; then
        nohup herdr-app >/dev/null 2>&1 &
        local i
        for i in {1..15}; do
            herdr-app status >/dev/null 2>&1 && break
            sleep 0.1
        done
    fi
}

resolve_notification_and_focus() {
    local notif_summary="${1:-}"
    local notif_body="${2:-}"

    local resolved
    resolved="$(
        python3 - "$SCRIPT_DIR/collect-fleet" "$notif_summary" "$notif_body" <<'PY' 2>/dev/null || true
import json
import subprocess
import sys

collector = sys.argv[1]
summary = (sys.argv[2] or "").strip()
body = (sys.argv[3] or "").strip()

try:
    res = subprocess.run(
        [sys.executable, collector, "--include-hc", "1", "--include-remote", "1", "--include-empty-spaces", "1"],
        capture_output=True,
        text=True,
        timeout=6.0,
        check=False,
    )
    fleet = json.loads(res.stdout) if res.stdout.strip() else {}
except Exception:
    fleet = {}

machines = fleet.get("machines") or []
summary_lc = summary.lower()
agent_hint = summary_lc.split()[0] if summary_lc.split() else ""
status_hint = ""
if "attention" in summary_lc or "blocked" in summary_lc:
    status_hint = "blocked"
elif "finished" in summary_lc or "done" in summary_lc:
    status_hint = "done"

parts = [p.strip() for p in body.split("·") if p.strip()]
machine_hint = ""
ws_hint = ""
tab_num = ""
extra_hint = ""

known_machines = {str(m.get("id") or "").lower(): m for m in machines}
for m in machines:
    sl = str(m.get("short_label") or "").lower()
    if sl:
        known_machines[sl] = m

if len(parts) >= 2 and parts[0].lower() in known_machines:
    machine_hint = parts[0].lower()
    parts = parts[1:]

if parts:
    ws_hint = parts[0].lower()
if len(parts) >= 2 and parts[1].isdigit():
    tab_num = parts[1]
    if len(parts) >= 3:
        extra_hint = " · ".join(parts[2:]).lower()
elif len(parts) >= 2:
    extra_hint = " · ".join(parts[1:]).lower()

best_agent = None
best_agent_score = -1
best_ws = None
best_ws_score = -1

for m in machines:
    m_id = str(m.get("id") or "local")
    m_short = str(m.get("short_label") or "").lower()
    m_backend = str(m.get("backend") or "herdr")
    m_bonus = 4 if m.get("isLocal") else 0
    if machine_hint and (m_id.lower() == machine_hint or m_short == machine_hint):
        m_bonus += 40

    for ws in m.get("workspaces") or []:
        ws_id = str(ws.get("workspace_id") or "")
        ws_label = str(ws.get("label") or "").strip().lower()
        ws_score = m_bonus
        if ws_hint:
            if ws_label == ws_hint or ws_id.lower() == ws_hint:
                ws_score += 60
            elif ws_hint in ws_label or ws_label in ws_hint:
                ws_score += 30

        if ws_score > best_ws_score:
            best_ws_score = ws_score
            inferred_tab = f"{ws_id}:t{tab_num}" if (tab_num and m_backend == "herdr" and ws_id) else ""
            best_ws = (m_backend, m_id, ws_id, inferred_tab)

        for ag in ws.get("agents") or []:
            score = ws_score
            ag_name = str(ag.get("agent") or "").lower()
            ag_status = str(ag.get("agent_status") or "").lower()
            ag_tab = str(ag.get("tab_id") or "")
            ag_title = str(ag.get("title") or "").lower()
            ag_sub = str(ag.get("subtitle") or "").lower()

            if agent_hint and ag_name == agent_hint:
                score += 25
            if status_hint and ag_status == status_hint:
                score += 20
            if tab_num and ag_tab.lower().endswith(f":t{tab_num}"):
                score += 35
            if extra_hint:
                if extra_hint == ag_title or extra_hint == ag_sub:
                    score += 35
                elif extra_hint in ag_title or extra_hint in ag_sub:
                    score += 20

            if score > best_agent_score:
                best_agent_score = score
                best_agent = (
                    m_backend,
                    m_id,
                    str(ag.get("pane_id") or ""),
                    ws_id,
                    ag_tab or (f"{ws_id}:t{tab_num}" if (tab_num and m_backend == "herdr" and ws_id) else ""),
                )

if best_agent and best_agent_score >= 45:
    print("\t".join(["agent", *best_agent]))
elif best_ws and best_ws_score >= 40:
    print("\t".join(["workspace", *best_ws]))
else:
    print("window\therdr\tlocal")
PY
    )"

    if [[ -n "$resolved" ]]; then
        local r_kind r_backend r_machine r_target r_ws r_tab
        IFS=$'\t' read -r r_kind r_backend r_machine r_target r_ws r_tab <<<"$resolved"
        if [[ "$r_kind" == "agent" && -n "$r_target" ]]; then
            exec "$0" agent "$r_backend" "$r_machine" "$r_target" "${r_ws:-}" "${r_tab:-}"
        elif [[ "$r_kind" == "workspace" && -n "$r_target" ]]; then
            exec "$0" workspace "$r_backend" "$r_machine" "$r_target" "${r_ws:-}"
        fi
    fi

    focus_niri_herdr_window "local"
    exit 0
}

ensure_runtime_env

if [[ "$kind" == "reemit-notification" ]]; then
    notif_summary="${2:-}"
    notif_body="${3:-}"
    command -v notify-send >/dev/null 2>&1 || exit 0
    action="$(
        timeout 14400 notify-send \
            --app-name="Herdr" \
            --icon="smart_toy" \
            --hint="boolean:suppress-sound:true" \
            --action="default=Open" \
            -- "$notif_summary" "$notif_body" 2>/dev/null || true
    )"
    if [[ "$action" == "default" ]]; then
        resolve_notification_and_focus "$notif_summary" "$notif_body"
    fi
    exit 0
fi

if [[ "$kind" == "notification" ]]; then
    notif_summary="${2:-}"
    notif_body="${3:-}"
    resolve_notification_and_focus "$notif_summary" "$notif_body"
fi

if [[ "$kind" == "window" ]]; then
    if [[ "$backend" == "hc" ]]; then
        ensure_hc_window_open
        focus_niri_hc_window
    else
        focus_niri_herdr_window "$machine"
    fi
    exit 0
fi

if [[ "$backend" == "hc" ]]; then
    ensure_hc_window_open
    if [[ "$kind" == "workspace" && -n "$target_id" && "$target_id" != "unassigned" ]]; then
        herdr-app do space.select --id "$target_id" >/dev/null 2>&1 || true
    elif [[ "$kind" == "agent" && -n "$target_id" ]]; then
        if [[ -n "$workspace_id" && "$workspace_id" != "unassigned" ]]; then
            herdr-app do space.select --id "$workspace_id" >/dev/null 2>&1 || true
        fi
        if [[ -n "$tab_id" ]]; then
            herdr-app do tab.select --id "$tab_id" >/dev/null 2>&1 || true
        fi
        herdr-app do agent.focus --terminal "$target_id" >/dev/null 2>&1 \
            || herdr-app do pane.focus --terminal "$target_id" >/dev/null 2>&1 \
            || true
    fi
    focus_niri_hc_window
    exit 0
fi

herdr_cmd=(herdr)
if [[ -n "$machine" && "$machine" != "local" ]]; then
    herdr_cmd=(herdr --machine "$machine")
fi

if [[ "$kind" == "workspace" && -n "$target_id" ]]; then
    "${herdr_cmd[@]}" workspace focus "$target_id" >/dev/null 2>&1 || true
    if [[ -n "$workspace_id" ]]; then
        # Optional 5th arg for workspace focus is tab_id
        "${herdr_cmd[@]}" tab focus "$workspace_id" >/dev/null 2>&1 || true
    fi
elif [[ "$kind" == "agent" && -n "$target_id" ]]; then
    if [[ -n "$workspace_id" ]]; then
        "${herdr_cmd[@]}" workspace focus "$workspace_id" >/dev/null 2>&1 || true
    fi
    if [[ -n "$tab_id" ]]; then
        "${herdr_cmd[@]}" tab focus "$tab_id" >/dev/null 2>&1 || true
    fi
    "${herdr_cmd[@]}" agent focus "$target_id" >/dev/null 2>&1 \
        || "${herdr_cmd[@]}" pane focus "$target_id" >/dev/null 2>&1 \
        || true
fi

focus_niri_herdr_window "$machine"
exit 0
