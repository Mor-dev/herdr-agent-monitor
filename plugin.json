{
    "$schema": "https://github.com/AvengeMedia/DankMaterialShell/raw/refs/heads/master/PLUGINS/plugin-schema.json",
    "id": "herdrAgentMonitor",
    "name": "herdr Agent Monitor",
    "description": "Multi-machine and workspace agent monitor for herdr and optional Herdr Desktop App (hc/herdr-app) with live status, context tokens, machine filter and pane focus (compositor window focus is Niri-only).",
    "version": "1.2.0",
    "author": "Mor-dev",
    "type": "widget",
    "icon": "smart_toy",
    "component": "./HerdrAgentMonitorWidget.qml",
    "settings": "./HerdrFleetSettings.qml",
    "capabilities": ["dankbar-widget", "monitoring", "ipc"],
    "permissions": ["process", "settings_read", "settings_write"],
    "dependencies": ["herdr", "python3", "jq"],
    "compositors": ["any"],
    "distro": ["any"],
    "requires_dms": ">=2.0.0"
}
